#!/bin/bash
set -e

PLIST_PATH="/Library/LaunchDaemons/dev.machbox.guest.plist"
LABEL="dev.machbox.guest"
SERVICE="system/${LABEL}"
AGENT="/usr/local/libexec/machbox-guest"

if launchctl print "${SERVICE}" >/dev/null 2>&1; then
    launchctl bootout system "${PLIST_PATH}" || true
fi

chown root:wheel "${PLIST_PATH}"
chmod 644 "${PLIST_PATH}"

chown root:wheel "${AGENT}"
chmod 755 "${AGENT}"

# Plugin steps and samples are children of the agent, so TCC judges them by
# the agent: without Full Disk Access, EndpointSecurity clients get
# ERR_NOT_PERMITTED and protected user data reads fail. The system TCC.db is
# only writable with SIP off; with SIP on, grant it in System Settings. The
# agent is ad-hoc signed, so its requirement is a cdhash that changes with
# every build: rewrite the grant on each install. Never fails the install.
grant_full_disk_access() {
    local db="/Library/Application Support/com.apple.TCC/TCC.db"
    local req blob

    if ! csrutil status 2>/dev/null | head -n 1 | grep -qi "status: *disabled"; then
        echo "SIP is enabled; grant Full Disk Access to ${AGENT} in System Settings"
        return 0
    fi
    # An ad-hoc signature's requirement is implicit and printed as "# designated => ...".
    req=$(codesign -d -r- "${AGENT}" 2>&1 | sed -n 's/^\(# \)\{0,1\}designated => //p')
    if [ -z "${req}" ]; then
        echo "no designated requirement for ${AGENT}; skipping Full Disk Access"
        return 0
    fi
    blob=$(mktemp -t machbox-csreq)
    # REPLACE overwrites the row with the same (service, client, client_type),
    # so reinstalls never pile up grants. set -e is off inside a function
    # called with ||, so check each step.
    if ! csreq -r- -b "${blob}" <<<"${req}" ||
        ! sqlite3 "${db}" "REPLACE INTO access
            (service, client, client_type, auth_value, auth_reason, auth_version, csreq, flags)
            VALUES ('kTCCServiceSystemPolicyAllFiles', '${AGENT}', 1, 2, 4, 1, X'$(xxd -p "${blob}" | tr -d '\n')', 0);"; then
        rm -f "${blob}"
        echo "granting Full Disk Access failed; grant it to ${AGENT} in System Settings"
        return 0
    fi
    rm -f "${blob}"
    killall tccd 2>/dev/null || true
    echo "Full Disk Access granted to ${AGENT}"
}
grant_full_disk_access || true

launchctl bootstrap system "${PLIST_PATH}"
launchctl kickstart -k "${SERVICE}"

# Runs are headless, so samples only get a logged-in GUI session if the
# guest logs in by itself. macOS needs the user's password for that, which
# is asked in a dialog on the user's desktop. Never fails the install.
configure_autologin() {
    local loginwindow="/Library/Preferences/com.apple.loginwindow"
    local user uid answer password tries

    if [ -n "$(defaults read "${loginwindow}" autoLoginUser 2>/dev/null)" ]; then
        echo "automatic login already enabled"
        return 0
    fi
    user=$(stat -f%Su /dev/console)
    if [ -z "${user}" ] || [ "${user}" = "root" ] || [ "${user}" = "loginwindow" ]; then
        echo "no user logged in; skipping automatic login"
        return 0
    fi
    uid=$(id -u "${user}")

    # $1: dialog text; $2: "password" for a hidden input field.
    # Prints the answer; fails if the user cancels or the dialog times out.
    ask() {
        local field=()
        if [ "$2" = "password" ]; then
            field=(-e 'set d to display dialog msg default answer "" with hidden answer buttons {"Skip", "Enable"} default button "Enable" cancel button "Skip" with title "Machbox" giving up after 600' \
                   -e 'if gave up of d then error number -128' \
                   -e 'text returned of d')
        else
            field=(-e 'display dialog msg buttons {"OK"} default button "OK" with title "Machbox" giving up after 600')
        fi
        launchctl asuser "${uid}" sudo -u "${user}" /usr/bin/osascript \
            -e "on run argv" -e "set msg to item 1 of argv" "${field[@]}" -e "end run" "$1"
    }

    if [ "$(fdesetup isactive 2>/dev/null)" = "true" ]; then
        ask "Automatic login is not possible while FileVault is on. Turn FileVault off in System Settings, then reinstall machbox-guest.pkg." info || true
        return 0
    fi

    for tries in 1 2 3; do
        answer=$(ask "Machbox runs samples in a logged-in session, so this VM has to log in automatically.

Enter the password of \"${user}\" to enable automatic login. It is stored in this VM in recoverable form, so it should be used nowhere else:" password) || {
            echo "automatic login skipped by the user"
            return 0
        }
        password=${answer}
        if dscl /Search -authonly "${user}" "${password}" >/dev/null 2>&1; then
            break
        fi
        password=""
        echo "wrong password for ${user} (attempt ${tries})"
    done
    if [ -z "${password}" ]; then
        ask "Wrong password; automatic login was not enabled." info || true
        return 0
    fi

    if sysadminctl -autologin set -userName "${user}" -password "${password}" >/dev/null 2>&1 &&
        [ "$(defaults read "${loginwindow}" autoLoginUser 2>/dev/null)" = "${user}" ]; then
        echo "automatic login enabled for ${user}"
    else
        ask "Enabling automatic login failed. Set it in System Settings → Users & Groups." info || true
    fi
}
configure_autologin || true

# Install Rosetta 2 on Apple Silicon if not already present.
if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ] && \
   ! pkgutil --pkg-info com.apple.pkg.RosettaUpdateAuto >/dev/null 2>&1; then
    /usr/sbin/softwareupdate --install-rosetta --agree-to-license
fi

# Install Xcode Command Line Tools silently if not already present.
if ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
    touch /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
    CLT_LABEL=$(/usr/sbin/softwareupdate --list 2>/dev/null | \
        awk -F': ' '/\*.*Command Line Tools for Xcode/{print $2}' | \
        sort -V | tail -n 1 || true)
    if [ -n "${CLT_LABEL}" ]; then
        /usr/sbin/softwareupdate --install "${CLT_LABEL}" --agree-to-license
    fi
    rm -f /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
fi

exit 0